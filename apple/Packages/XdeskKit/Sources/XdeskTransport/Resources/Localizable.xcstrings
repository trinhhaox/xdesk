{
  "sourceLanguage" : "vi",
  "strings" : {
    "Chưa có thiết bị đối tác" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No peer device" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chưa có thiết bị đối tác" } }
      }
    },
    "Chưa ghép đôi với máy này: quét mã QR hoặc so mã 6 số" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Not paired with this Mac. Scan the QR code or compare the 6-digit code." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chưa ghép đôi với máy này: quét mã QR hoặc so mã 6 số" } }
      }
    },
    "Địa chỉ không hợp lệ. Nhập IP (100.x.y.z) hoặc tên máy, tuỳ chọn thêm :cổng." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Invalid address. Enter an IP address (100.x.y.z) or a host name, optionally followed by :port." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Địa chỉ không hợp lệ. Nhập IP (100.x.y.z) hoặc tên máy, tuỳ chọn thêm :cổng." } }
      }
    },
    "Đã đủ %@ máy; hãy xoá bớt trước khi thêm." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The limit of %@ Macs is reached. Remove one before adding another." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đã đủ %@ máy; hãy xoá bớt trước khi thêm." } }
      }
    },
    "Đối tác vi phạm giao thức: %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The peer violated the protocol: %@" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đối tác vi phạm giao thức: %@" } }
      }
    },
    "Ghép đôi bằng mã bị khoá tạm thời do thử sai quá nhiều lần" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Pairing with a code is temporarily locked after too many failed attempts." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Ghép đôi bằng mã bị khoá tạm thời do thử sai quá nhiều lần" } }
      }
    },
    "Hết thời gian chờ" : {
