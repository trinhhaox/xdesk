      }
    },
    "Khoá của máy host không khớp (host cài lại hoặc thiết bị mạo danh): không kết nối" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The host Mac's key doesn't match (it was reinstalled, or another device is impersonating it). Not connecting." } },
