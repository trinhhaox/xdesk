      }
    },
    "Máy Mac đã thu hồi quyền của thiết bị này. Ghép đôi lại để dùng tiếp." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Mac revoked access for this device. Pair again to continue." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Máy Mac đã thu hồi quyền của thiết bị này. Ghép đôi lại để dùng tiếp." } }
      }
    },
    "Máy Mac từ chối kết nối, có thể đã thu hồi thiết bị này. Ghép đôi lại để dùng tiếp." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Mac refused the connection and may have revoked this device. Pair again to continue." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Máy Mac từ chối kết nối, có thể đã thu hồi thiết bị này. Ghép đôi lại để dùng tiếp." } }
