{
  "sourceLanguage": "vi",
  "strings": {
    "%@ (tạm dừng)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (paused)"
          }
        }
      }
    },
    "%@ (tạm dừng: %@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (paused: %@)"
          }
        }
      }
    },
    "%@ (đang hoạt động)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (active)"
          }
        }
      }
    },
    "%@ muốn ghép đôi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wants to pair"
          }
        }
      }
    },
    "%@ muốn điều khiển màn hình agent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wants to control the agent display"
          }
        }
      }
    },
    "%@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        }
      }
    },
    "%@ · IP lần trước %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Previous IP %@"
          }
        }
      }
    },
    "%@ đang điều khiển": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is in control"
          }
        }
      }
    },
    "Agent AI": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Agent"
          }
        }
      }
    },
    "Agent AI lỗi: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Agent error: %@"
          }
        }
      }
    },
    "Agent AI xin quyền": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Agent Permission Request"
          }
        }
      }
    },
    "Agent chỉ làm việc trên màn hình ảo \"Xdesk Agent\". Bạn có thể tạm dừng bất kỳ lúc nào bằng banner hoặc ⌃⌥⌘.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent only works on the virtual display \"Xdesk Agent\". You can pause at any time with the banner or ⌃⌥⌘."
          }
        }
      }
    },
    "Agent đã tạm dừng": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent paused"
          }
        }
      }
    },
    "Bundle id, ví dụ com.apple.TextEdit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundle ID, for example com.apple.TextEdit"
          }
        }
      }
    },
    "Bản sao · Cảm ứng": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirror · Touch"
          }
        }
      }
    },
    "Bản sao · Gốc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirror · Native"
          }
        }
      }
    },
    "Bản sao · Vừa thiết bị": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirror · Fit to Device"
          }
        }
      }
    },
    "Bản thử nghiệm đang chạy không mã hoá nên không có ghép đôi. Hãy chạy lại không kèm --plaintext.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This test build is running without encryption, so pairing is unavailable. Run it again without --plaintext."
          }
        }
      }
    },
    "Bắt đầu chia sẻ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Sharing"
          }
        }
      }
    },
    "Cho phép": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow"
          }
        }
      }
    },
    "Cho phép agent AI (MCP)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow AI Agent (MCP)"
          }
        }
      }
    },
    "Cho phép kết nối qua Tailscale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Connections over Tailscale"
          }
        }
      }
    },
    "Cho phép thiết bị đã ghép nhìn thấy Mac này": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets paired devices see this Mac"
          }
        }
      }
    },
    "Chung": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General"
          }
        }
      }
    },
    "Chưa bật chia sẻ màn hình. Hãy chọn \"Bắt đầu chia sẻ màn hình\" trong menu rồi mở lại cửa sổ này.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen sharing is off. Choose \"Start Sharing Screen\" in the menu, then reopen this window."
          }
        }
      }
    },
    "Chưa có": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not available"
          }
        }
      }
    },
    "Chưa có máy nào.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Macs yet."
          }
        }
      }
    },
    "Chưa có quyền Ghi màn hình. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording permission is missing. %@"
          }
        }
      }
    },
    "Chưa có thiết bị nào đang xem.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No devices are viewing."
          }
        }
      }
    },
    "Chưa có thiết bị nào. Chọn \"Ghép đôi thiết bị mới…\" ở thanh menu Xdesk.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No devices yet. Choose \"Pair New Device…\" from the Xdesk menu bar item."
          }
        }
      }
    },
    "Chưa cắm iPhone/iPad. Cắm cáp và mở Xdesk trên thiết bị.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No iPhone or iPad connected. Plug in the cable and open Xdesk on the device."
          }
        }
      }
    },
    "Chưa kiểm tra lần nào": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never checked"
          }
        }
      }
    },
    "Chưa kết nối lần nào": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never connected"
          }
        }
      }
    },
    "Chưa thấy Tailscale trên máy này": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale not found on this Mac"
          }
        }
      }
    },
    "Chỉ làm việc này nếu bạn biết máy kia vừa được cài lại. Sau đó bạn phải ghép đôi lại bằng mã 6 số.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only do this if you know the other Mac was just reinstalled. You will then need to pair again with a 6-digit code."
          }
        }
      }
    },
    "Chỉ phát âm thanh trên thiết bị (tắt loa Mac)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play audio only on the device (mute Mac speakers)"
          }
        }
      }
    },
    "Chụp phím hệ thống (⌘-Tab, ⌘-Space)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture System Shortcuts (⌘-Tab, ⌘-Space)"
          }
        }
      }
    },
    "Clipboard": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard"
          }
        }
      }
    },
    "Cài đặt hệ thống › Quyền riêng tư & Bảo mật › Ghi màn hình và âm thanh hệ thống › bật Xdesk": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System Settings › Privacy & Security › Screen & System Audio Recording › turn on Xdesk"
          }
        }
      }
    },
    "Cài đặt…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings…"
          }
        }
      }
    },
    "Cách ghép: %@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Method: %@ · %@"
          }
        }
      }
    },
    "Cáp USB": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "USB Cable"
          }
        }
      }
    },
    "Có bản mới %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@ is available"
          }
        }
      }
    },
    "Cấm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never"
          }
        }
      }
    },
    "Cần cấp quyền": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission Needed"
          }
        }
      }
    },
    "Cần quyền Trợ năng để điều khiển": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility Permission Required for Control"
          }
        }
      }
    },
    "Cập nhật": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates"
          }
        }
      }
    },
    "Cập nhật %@…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update %@…"
          }
        }
      }
    },
    "Cửa sổ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows"
          }
        }
      }
    },
    "Danh sách thiết bị từng bị sửa hoặc hỏng nên Xdesk đã bỏ đi và tạo danh sách trống. Hãy ghép đôi lại các thiết bị của bạn.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device list was modified or corrupted, so Xdesk discarded it and created an empty list. Pair your devices again."
          }
        }
      }
    },
    "Dấu vân tay": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fingerprint"
          }
        }
      }
    },
    "Dấu vân tay của Mac này": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac's Fingerprint"
          }
        }
      }
    },
    "Dừng": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        }
      }
    },
    "Dừng chia sẻ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop Sharing"
          }
        }
      }
    },
    "Dừng nhanh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Stop"
          }
        }
      }
    },
    "Dừng nhanh bằng %@. Chạm chuột/bàn phím vào màn hình agent cũng tự tạm dừng.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop quickly with %@. Touching the mouse or keyboard on the agent display also pauses automatically."
          }
        }
      }
    },
    "Ghi màn hình": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording"
          }
        }
      }
    },
    "Ghép thêm thiết bị": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair Another Device"
          }
        }
      }
    },
    "Ghép đôi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair"
          }
        }
      }
    },
    "Ghép đôi bằng mã 6 số": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair with 6-Digit Code"
          }
        }
      }
    },
    "Ghép đôi thiết bị mới": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair New Device"
          }
        }
      }
    },
    "Ghép đôi thiết bị mới…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair New Device…"
          }
        }
      }
    },
    "Giám sát đầu vào": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input Monitoring"
          }
        }
      }
    },
    "Gặp lỗi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Error"
          }
        }
      }
    },
    "Gỡ màn hình agent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove Agent Display"
          }
        }
      }
    },
    "Gửi ⌘-Tab và ⌘-Space sang máy được điều khiển thay vì xử lý trên Mac này. Cần quyền Trợ năng.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send ⌘-Tab and ⌘-Space to the controlled Mac instead of handling them on this Mac. Requires Accessibility permission."
          }
        }
      }
    },
    "Hiện tại": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current"
          }
        }
      }
    },
    "Hỏi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask"
          }
        }
      }
    },
    "Khoá của Mac nằm ở chùm khoá đăng nhập cũ nên kém an toàn hơn. Hãy cài bản Xdesk đã ký đầy đủ rồi ghép đôi lại.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac's key is stored in the legacy login keychain, which is less secure. Install a fully signed build of Xdesk, then pair again."
          }
        }
      }
    },
    "Khoá của máy này đã đổi: máy được cài lại hoặc có thiết bị khác đang mạo danh. Không kết nối.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac's key has changed: it was reinstalled, or another device is impersonating it. Not connecting."
          }
        }
      }
    },
    "Không khớp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doesn't Match"
          }
        }
      }
    },
    "Không mở được kho khoá bảo mật": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't open the security key store"
          }
        }
      }
    },
    "Không mở được kho khoá bảo mật: %@. Ghép đôi và kết nối mã hoá đang tắt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't open the secure key store: %@. Pairing and encrypted connections are turned off."
          }
        }
      }
    },
    "Không sắp xếp được màn hình ảo (CGError %@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't arrange the virtual display (CGError %@)"
          }
        }
      }
    },
    "Không tìm thấy màn hình %@ để capture": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't find display %@ to capture"
          }
        }
      }
    },
    "Không tạo được ảnh mã QR.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't create the QR code image."
          }
        }
      }
    },
    "Không đổi được cài đặt khởi động: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't change the startup setting: %@"
          }
        }
      }
    },
    "Không đổi được token: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't rotate the token: %@"
          }
        }
      }
    },
    "Khớp, cho phép": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matches, Allow"
          }
        }
      }
    },
    "Khởi động": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Startup"
          }
        }
      }
    },
    "Khởi động lại Xdesk để áp dụng ngôn ngữ mới.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart Xdesk to apply the new language."
          }
        }
      }
    },
    "Kiểm tra cập nhật…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for Updates…"
          }
        }
      }
    },
